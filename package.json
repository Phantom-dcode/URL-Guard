{
  "name": "url-guard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "build": "node scripts/package_extension.js && esbuild src/history-chart.tsx --bundle --minify --outfile=app/static/history-chart.bundle.js '--define:process.env.NODE_ENV=\"production\"'",
    "build:chart": "esbuild src/history-chart.tsx --bundle --minify --outfile=app/static/history-chart.bundle.js '--define:process.env.NODE_ENV=\"production\"'",
    "build:extension": "node scripts/package_extension.js",
    "start": "node server.js",
    "test": "node tests/test_regression.mjs && node tests/test_threshold_boundaries.mjs && node tests/test_extension_sync.mjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
